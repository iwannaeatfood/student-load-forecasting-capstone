.git/
.gitignore
.pytest_cache/
.mypy_cache/
.ruff_cache/
__pycache__/
*.py[cod]
*$py.class

.venv/
venv/
env/
.env
.env.*

build/
dist/
*.egg-info/
.coverage
coverage.xml
htmlcov/

.ipynb_checkpoints/
.idea/
.vscode/

outputs/forecasts/**
outputs/metrics/**
outputs/figures/**
!outputs/forecasts/.gitkeep
!outputs/metrics/.gitkeep
!outputs/figures/.gitkeep

data/raw/**
data/interim/**
data/processed/**
*.csv
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep
